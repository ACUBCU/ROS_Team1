<?xml version="1.0" ?>
<sdf version='1.10'>
  <world name='final'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>
    <gui>
      <camera name='user_camera'>
        <pose>0 0 10 0 -1.5700000000004057 0</pose>
      </camera>
    </gui>


<model name='front_wall'>
      <pose>1.0 0 0.25 0 0 0</pose>
      <static>true</static>
      <link name='wall_link'>
        <!-- 벽 본체 -->
        <collision name='wall_collision'>
          <geometry>
            <box>
              <size>0.1 1.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name='wall_visual'>
          <geometry>
            <box>
              <size>0.1 1.0 0.5</size>
            </box>
          </geometry>
          <material>
            <!-- 순수한 흰색으로 설정 -->
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>


      </link>
    </model>


    <model name='ground_plan_a'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.800000012 0.800000012 0.800000012 1</ambient>
            <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
            <specular>0.800000012 0.800000012 0.800000012 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <model name='box'>
      <pose>5.3351101875305176 1.1423105628707289 0.49999964374511835 2.2249889111800282e-07 3.5031224552452505e-17 -6.3657622294056747e-17</pose>
      <link name='box_link'>
        <inertial>
          <inertia>
            <ixx>0.16666</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.16666</iyy>
            <iyz>0</iyz>
            <izz>0.16666</izz>
          </inertia>
          <mass>1</mass>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <collision name='box_collision'>
          <geometry>
            <box>
              <size>0.10000000000000001 5 0.5</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='box_visual'>
          <geometry>
            <box>
              <size>0.10000000000000001 5 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.300000012 0.300000012 0.300000012 1</ambient>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
            <specular>1 1 1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <static>false</static>
      <self_collide>false</self_collide>
    </model>


<!-- 6번 구역 (빨간색 계열) -->
    <model name="zone_6">
      <static>true</static>
      <pose>-0.15 0.20 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 7번 구역 (주황색 계열) -->
    <model name="zone_7">
      <static>true</static>
      <pose>-0.15 0.10 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 8번 구역 (노란색 계열 - 중앙) -->
    <model name="zone_8">
      <static>true</static>
      <pose>-0.15 0.00 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 9번 구역 (초록색 계열) -->
    <model name="zone_9">
      <static>true</static>
      <pose>-0.15 -0.10 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 10번 구역 (파란색 계열) -->
    <model name="zone_10">
      <static>true</static>
      <pose>-0.15 -0.20 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>


<!-- 1. 전체 탑뷰 카메라 (위에서 아래로 수직으로 내려다봄) -->
    <model name="camera_top_model">
      <static>true</static>
      <!-- Z축 1m 높이에서 피치(Pitch)를 1.57(90도)로 꺾어 수직으로 바라봄 -->
      <pose>0.0 0.0 1.0 0 1.5708 0</pose>
      <link name="link">
        <sensor name="camera_top" type="camera">
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>30</update_rate><visualize>true</visualize>
          <topic>/camera_top/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- 2. 큐브 뷰 카메라 (정면에 생성되는 큐브들을 집중해서 바라봄) -->
    <model name="camera_cube_model">
      <static>true</static>
      <!-- 로봇 앞쪽(X: 0.75)에서 로봇 방향(Yaw: -3.14)으로 비스듬히(Pitch: 0.5) 내려다봄 -->
      <pose>0.75 0.0 0.4 0 0.5 -3.1415</pose>
      <link name="link">
        <sensor name="camera_cube" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>30</update_rate><visualize>true</visualize>
          <topic>/camera_cube/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- 3. 장소 뷰 카메라 (뒤쪽 6~10번 구역을 집중해서 바라봄) -->
    <model name="camera_place_model">
      <static>true</static>
      <!-- 로봇 뒤쪽(X: -0.75)에서 놓는 장소 방향(Yaw: 0)으로 비스듬히(Pitch: 0.5) 내려다봄 -->
      <pose>-0.75 0.0 0.4 0 0.5 0</pose>
      <link name="link">
        <sensor name="camera_place" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on><update_rate>30</update_rate><visualize>true</visualize>
          <topic>/camera_place/image_raw</topic>
        </sensor>
      </link>
    </model>


    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.0099999997764825821</linear>
        <constant>0.89999997615814209</constant>
        <quadratic>0.0010000000474974513</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>