<?xml version="1.0" ?>
<sdf version='1.9'>
  <model name='aruco_cube'>
    <link name="cube_link">
        
        <!-- 질량 및 관성 정보 -->
        <inertial>
            <mass>0.05</mass>
            <inertia>
                <ixx>0.00002083</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.00002083</iyy>
                <iyz>0</iyz>
                <izz>0.00002083</izz>
            </inertia>
        </inertial>

        <collision name="cube_collision">
            <geometry>
                <box>
                    <size>0.04 0.04 0.04</size>
                </box>
            </geometry>
            <!-- 그리핑 시 미끄러짐 방지를 위한 표면 마찰력 -->
            <surface>
                <friction>
                    <ode>
                        <mu>100.0</mu>
                        <mu2>100.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>

        <visual name="cube_visual">
            <geometry>
                <box>
                    <size>0.04 0.04 0.04</size>
                </box>
            </geometry>
            <material>
                <ambient>1 1 1 1</ambient>
                <diffuse>1 1 1 1</diffuse>
                <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>

        

    </link>
  </model>
</sdf>