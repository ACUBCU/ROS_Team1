<?xml version="1.0"?>
<sdf version="1.10">
  <model name="simple_sorting_arm">
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose relative_to="__model__">0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.018</ixx><iyy>0.018</iyy><izz>0.032</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_visual">
        <geometry><cylinder><radius>0.10</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.08 0.10 0.14 1</ambient>
          <diffuse>0.12 0.16 0.22 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <collision name="base_collision">
        <geometry><cylinder><radius>0.10</radius><length>0.12</length></cylinder></geometry>
      </collision>
    </link>

    <link name="yaw_link">
      <pose relative_to="__model__">0 0 0.14 0 0 0</pose>
      <inertial>
        <mass>0.50</mass>
        <inertia>
          <ixx>0.0007</ixx><iyy>0.0007</iyy><izz>0.0013</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="yaw_visual">
        <geometry><cylinder><radius>0.075</radius><length>0.05</length></cylinder></geometry>
        <material>
          <ambient>0.12 0.45 0.72 1</ambient>
          <diffuse>0.16 0.55 0.88 1</diffuse>
        </material>
      </visual>
      <collision name="yaw_collision">
        <geometry><cylinder><radius>0.075</radius><length>0.05</length></cylinder></geometry>
      </collision>
    </link>

    <link name="upper_arm_link">
      <pose relative_to="__model__">0 0 0.20 0 0 0</pose>
      <inertial>
        <pose>0.17 0 0 0 0 0</pose>
        <mass>0.60</mass>
        <inertia>
          <ixx>0.00036</ixx><iyy>0.00596</iyy><izz>0.00596</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="upper_arm_visual">
        <pose>0.17 0 0 0 0 0</pose>
        <geometry><box><size>0.34 0.06 0.06</size></box></geometry>
        <material>
          <ambient>0.86 0.39 0.09 1</ambient>
          <diffuse>0.96 0.48 0.10 1</diffuse>
        </material>
      </visual>
      <collision name="upper_arm_collision">
        <pose>0.17 0 0 0 0 0</pose>
        <geometry><box><size>0.34 0.06 0.06</size></box></geometry>
      </collision>
    </link>

    <link name="forearm_link">
      <pose relative_to="__model__">0.34 0 0.20 0 0 0</pose>
      <inertial>
        <pose>0.18 0 0 0 0 0</pose>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.00019</ixx><iyy>0.00496</iyy><izz>0.00496</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="forearm_visual">
        <pose>0.18 0 0 0 0 0</pose>
        <geometry><box><size>0.36 0.05 0.05</size></box></geometry>
        <material>
          <ambient>0.16 0.55 0.34 1</ambient>
          <diffuse>0.20 0.70 0.43 1</diffuse>
        </material>
      </visual>
      <collision name="forearm_collision">
        <pose>0.18 0 0 0 0 0</pose>
        <geometry><box><size>0.36 0.05 0.05</size></box></geometry>
      </collision>
    </link>

    <link name="tool_link">
      <pose relative_to="__model__">0.70 0 0.20 0 0 0</pose>
      <inertial>
        <pose>0.03 0 0 0 0 0</pose>
        <mass>0.20</mass>
        <inertia>
          <ixx>0.00027</ixx><iyy>0.00019</iyy><izz>0.00027</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="tool_visual">
        <pose>0.025 0 0 0 0 0</pose>
        <geometry><box><size>0.05 0.12 0.04</size></box></geometry>
        <material>
          <ambient>0.16 0.16 0.18 1</ambient>
          <diffuse>0.25 0.25 0.28 1</diffuse>
        </material>
      </visual>
      <collision name="tool_collision">
        <pose>0.025 0 0 0 0 0</pose>
        <geometry><box><size>0.05 0.12 0.04</size></box></geometry>
      </collision>
    </link>

    <link name="left_finger_link">
      <pose relative_to="__model__">0.70 0.0475 0.20 0 0 0</pose>
      <inertial>
        <pose>0.03 0 -0.05 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000043</ixx><iyy>0.000057</iyy><izz>0.000016</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="left_finger_visual">
        <pose>0.03 0 -0.05 0 0 0</pose>
        <geometry><box><size>0.06 0.015 0.10</size></box></geometry>
        <material>
          <ambient>0.72 0.72 0.76 1</ambient>
          <diffuse>0.86 0.86 0.90 1</diffuse>
        </material>
      </visual>
      <collision name="left_finger_collision">
        <pose>0.03 0 -0.05 0 0 0</pose>
        <geometry><box><size>0.06 0.015 0.10</size></box></geometry>
      </collision>
    </link>

    <link name="right_finger_link">
      <pose relative_to="__model__">0.70 -0.0475 0.20 0 0 0</pose>
      <inertial>
        <pose>0.03 0 -0.05 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.000043</ixx><iyy>0.000057</iyy><izz>0.000016</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="right_finger_visual">
        <pose>0.03 0 -0.05 0 0 0</pose>
        <geometry><box><size>0.06 0.015 0.10</size></box></geometry>
        <material>
          <ambient>0.72 0.72 0.76 1</ambient>
          <diffuse>0.86 0.86 0.90 1</diffuse>
        </material>
      </visual>
      <collision name="right_finger_collision">
        <pose>0.03 0 -0.05 0 0 0</pose>
        <geometry><box><size>0.06 0.015 0.10</size></box></geometry>
      </collision>
    </link>

    <joint name="world_fixed_joint" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
    </joint>

    <joint name="base_yaw_joint" type="revolute">
      <pose relative_to="yaw_link"/>
      <parent>base_link</parent>
      <child>yaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-2.60</lower><upper>2.60</upper><effort>40</effort><velocity>1.8</velocity></limit>
        <dynamics><damping>0.40</damping><friction>0.10</friction></dynamics>
      </axis>
    </joint>

    <joint name="shoulder_joint" type="revolute">
      <pose relative_to="upper_arm_link"/>
      <parent>yaw_link</parent>
      <child>upper_arm_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.45</lower><upper>1.10</upper><effort>90</effort><velocity>1.6</velocity></limit>
        <dynamics><damping>0.55</damping><friction>0.12</friction></dynamics>
      </axis>
    </joint>

    <joint name="elbow_joint" type="revolute">
      <pose relative_to="forearm_link"/>
      <parent>upper_arm_link</parent>
      <child>forearm_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.20</lower><upper>2.35</upper><effort>75</effort><velocity>1.8</velocity></limit>
        <dynamics><damping>0.45</damping><friction>0.10</friction></dynamics>
      </axis>
    </joint>

    <joint name="tool_fixed_joint" type="fixed">
      <pose relative_to="tool_link"/>
      <parent>forearm_link</parent>
      <child>tool_link</child>
    </joint>

    <joint name="left_finger_joint" type="prismatic">
      <pose relative_to="left_finger_link"/>
      <parent>tool_link</parent>
      <child>left_finger_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>0.0</lower><upper>0.035</upper><effort>15</effort><velocity>0.10</velocity></limit>
        <dynamics><damping>0.30</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>

    <joint name="right_finger_joint" type="prismatic">
      <pose relative_to="right_finger_link"/>
      <parent>tool_link</parent>
      <child>right_finger_link</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit><lower>0.0</lower><upper>0.035</upper><effort>15</effort><velocity>0.10</velocity></limit>
        <dynamics><damping>0.30</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>base_yaw_joint</joint_name><topic>/arm/base_yaw/cmd_pos</topic>
      <p_gain>90</p_gain><i_gain>0</i_gain><d_gain>9</d_gain>
      <cmd_min>-40</cmd_min><cmd_max>40</cmd_max>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_joint</joint_name><topic>/arm/shoulder/cmd_pos</topic>
      <p_gain>260</p_gain><i_gain>0.2</i_gain><d_gain>26</d_gain>
      <i_min>-3</i_min><i_max>3</i_max><cmd_min>-90</cmd_min><cmd_max>90</cmd_max>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_joint</joint_name><topic>/arm/elbow/cmd_pos</topic>
      <p_gain>220</p_gain><i_gain>0.15</i_gain><d_gain>22</d_gain>
      <i_min>-3</i_min><i_max>3</i_max><cmd_min>-75</cmd_min><cmd_max>75</cmd_max>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_finger_joint</joint_name><topic>/arm/left_finger/cmd_pos</topic>
      <p_gain>180</p_gain><i_gain>0</i_gain><d_gain>8</d_gain>
      <cmd_min>-15</cmd_min><cmd_max>15</cmd_max>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_finger_joint</joint_name><topic>/arm/right_finger/cmd_pos</topic>
      <p_gain>180</p_gain><i_gain>0</i_gain><d_gain>8</d_gain>
      <cmd_min>-15</cmd_min><cmd_max>15</cmd_max>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/arm/joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>tool_link</parent_link>
      <child_model>marker0_box</child_model>
      <child_model_link>box_link</child_model_link>
      <attach_topic>/arm/grasp/marker0/attach</attach_topic>
      <detach_topic>/arm/grasp/marker0/detach</detach_topic>
      <output_topic>/arm/grasp/marker0/state</output_topic>
    </plugin>

    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>tool_link</parent_link>
      <child_model>marker1_box</child_model>
      <child_model_link>box_link</child_model_link>
      <attach_topic>/arm/grasp/marker1/attach</attach_topic>
      <detach_topic>/arm/grasp/marker1/detach</detach_topic>
      <output_topic>/arm/grasp/marker1/state</output_topic>
    </plugin>
  </model>
</sdf>

