<?xml version="1.0"?>
<sdf version="1.10">
  <world name="aruco_sorting">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.68 0.73 0.80 1</background>
      <shadows>true</shadows>
    </scene>
    <gui>
      <camera name="user_camera">
        <pose>0.72 -0.72 0.58 0 0.48 2.35</pose>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.5 0.3 -0.9</direction>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>2 2</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>2 2</size></plane></geometry>
          <material>
            <ambient>0.38 0.41 0.45 1</ambient>
            <diffuse>0.48 0.51 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- OpenMANIPULATOR-X의 place 자세에서 end_effector가 오는 위치 -->
    <model name="destination_A">
      <static>true</static>
      <pose>0.106 0.242 0.001 0 0 1.20</pose>
      <link name="plate_link">
        <visual name="plate_visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>0.72 0.08 0.08 1</ambient>
            <diffuse>0.92 0.12 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="destination_B">
      <static>true</static>
      <pose>0.106 -0.242 0.001 0 0 -1.20</pose>
      <link name="plate_link">
        <visual name="plate_visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>0.06 0.22 0.72 1</ambient>
            <diffuse>0.10 0.32 0.94 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- pick 자세의 end_effector 좌표와 일치시킨 두 ArUco 박스 -->
    <include>
      <uri>model://aruco_box_0</uri>
      <name>marker0_box</name>
      <pose>0.246 0.113 0.0225 0 0 0.45</pose>
    </include>
    <include>
      <uri>model://aruco_box_1</uri>
      <name>marker1_box</name>
      <pose>0.246 -0.113 0.0225 0 0 -0.45</pose>
    </include>
  </world>
</sdf>
