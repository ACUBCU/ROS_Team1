<?xml version="1.0" ?>
<sdf version='1.10'>
  <model name='person_photo'>
    <static>true</static>
    <link name="photo_link">
        <collision name="photo_collision">
            <geometry>
                <box>
                    <size>0.01 0.3 0.5</size>
                </box>
            </geometry>
        </collision>

        <visual name="photo_visual">
            <geometry>
                <box>
                    <size>0.01 0.3 0.5</size>
                </box>
            </geometry>
            <material>
                <ambient>1 1 1 1</ambient>
                <diffuse>1 1 1 1</diffuse>
                <pbr>
                    <metal>
                        <albedo_map>
                            material/textures/person_silhouette.png
                        </albedo_map>
                        <roughness>1.0</roughness>
                        <metalness>0.0</metalness>
                    </metal>
                </pbr>
            </material>
        </visual>
    </link>
  </model>
</sdf>
